      LAYER Metal4 ;
        RECT 5.850 0.000 9.600 154.180 ;
    END
  END GPWR
  PIN ctrl
    DIRECTION INPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 0.915200 ;
    PORT
      LAYER Metal4 ;
        RECT 0.000 154.480 9.600 154.980 ;
    END
  END ctrl
  OBS
      LAYER GatPoly ;
        RECT 0.340 0.540 9.260 154.490 ;
      LAYER Metal1 ;
        RECT 0.000 0.610 9.600 154.420 ;
      LAYER Metal2 ;
        RECT 0.000 0.300 9.600 154.980 ;
      LAYER Metal3 ;
        RECT 0.000 0.000 9.600 154.980 ;
  END
END tt_pg_1v5_ll_1
